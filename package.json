{
  "name": "testlash-tizmi",
  "version": "1.0.0",
  "description": "A fully functional test-solving web application with admin panel, user authentication, image/video upload via Cloudinary, and PostgreSQL database. Built with Node.js/Express backend and React frontend.",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "cd server && nodemon server.js",
    "build": "npm install && npm run migrate",
    "migrate": "node server/migrate.js",
    "install-server": "cd server && npm install",
    "install-client": "cd client && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "eslint": "^9.38.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.9",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
