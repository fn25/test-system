# Backend API URL
REACT_APP_API_URL=https://your-backend-url.onrender.com/api

# ImageKit Configuration
# Get these from: https://imagekit.io/dashboard/developer/api-keys
REACT_APP_IMAGEKIT_PUBLIC_KEY=your_public_key_here
REACT_APP_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
REACT_APP_IMAGEKIT_AUTH_ENDPOINT=https://your-backend-url.onrender.com/api/imagekit/auth
